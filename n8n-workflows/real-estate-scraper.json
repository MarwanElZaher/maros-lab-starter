{
  "name": "Real Estate Scraper Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "real-estate-scrape",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "re000001-0001-4000-8000-000000000001",
      "name": "Webhook — Receive Search Params",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "real-estate-scrape"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job-id-assign",
              "name": "jobId",
              "value": "={{ $now.toMillis() + '-' + $execution.id }}",
              "type": "string"
            },
            {
              "id": "location-assign",
              "name": "location",
              "value": "={{ $json.body.location }}",
              "type": "string"
            },
            {
              "id": "sizeMin-assign",
              "name": "sizeMin",
              "value": "={{ $json.body.sizeMin }}",
              "type": "number"
            },
            {
              "id": "sizeMax-assign",
              "name": "sizeMax",
              "value": "={{ $json.body.sizeMax }}",
              "type": "number"
            },
            {
              "id": "priceMax-assign",
              "name": "priceMax",
              "value": "={{ $json.body.priceMax ?? null }}",
              "type": "string"
            },
            {
              "id": "runLabel-assign",
              "name": "runLabel",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm') + ' | ' + $json.body.location }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "re000001-0002-4000-8000-000000000002",
      "name": "Set — Prepare Params",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ jobId: $json.jobId }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "re000001-0003-4000-8000-000000000003",
      "name": "Respond — Return JobId",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://olx-scraper:3001/scrape",
        "sendBody": true,
        "bodyContentType": "json",
        "bodyParameters": {
          "parameters": []
        },
        "jsonBody": "={{ JSON.stringify({ location: $json.location, sizeMin: $json.sizeMin, sizeMax: $json.sizeMax, priceMax: $json.priceMax }) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "re000001-0004-4000-8000-000000000004",
      "name": "HTTP — Call OLX Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "listings-exist",
              "leftValue": "={{ $json.listings.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "re000001-0005-4000-8000-000000000005",
      "name": "If — Has Listings?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "listings",
        "options": {}
      },
      "id": "re000001-0006-4000-8000-000000000006",
      "name": "Split Out — Each Listing",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Set — Prepare Params').item.json.runLabel }}",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "post_url": "={{ $json.post_url }}",
            "mobile_number": "={{ $json.mobile_number }}",
            "description_snippet": "={{ $json.description_snippet }}",
            "price": "={{ $json.price }}",
            "size": "={{ $json.size }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "post_url", "displayName": "post_url", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "mobile_number", "displayName": "mobile_number", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "description_snippet", "displayName": "description_snippet", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "price", "displayName": "price", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "size", "displayName": "size", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "re000001-0007-4000-8000-000000000007",
      "name": "Google Sheets — Append Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1560, 220],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-oauth",
          "name": "Google Sheets OAuth"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'scraper returned no listings', jobId: $('Set — Prepare Params').item.json.jobId }) }}",
        "options": { "responseCode": 204 }
      },
      "id": "re000001-0008-4000-8000-000000000008",
      "name": "No Listings — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 420]
    }
  ],
  "connections": {
    "Webhook — Receive Search Params": {
      "main": [
        [{ "node": "Set — Prepare Params", "type": "main", "index": 0 }]
      ]
    },
    "Set — Prepare Params": {
      "main": [
        [{ "node": "Respond — Return JobId", "type": "main", "index": 0 }]
      ]
    },
    "Respond — Return JobId": {
      "main": [
        [{ "node": "HTTP — Call OLX Scraper", "type": "main", "index": 0 }]
      ]
    },
    "HTTP — Call OLX Scraper": {
      "main": [
        [{ "node": "If — Has Listings?", "type": "main", "index": 0 }]
      ]
    },
    "If — Has Listings?": {
      "main": [
        [{ "node": "Split Out — Each Listing", "type": "main", "index": 0 }],
        [{ "node": "No Listings — Skip", "type": "main", "index": 0 }]
      ]
    },
    "Split Out — Each Listing": {
      "main": [
        [{ "node": "Google Sheets — Append Rows", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["real-estate", "olx", "google-sheets"],
  "pinData": {},
  "versionId": "1.0.0",
  "meta": {
    "templateId": "real-estate-scraper",
    "instanceId": "maros-lab"
  }
}
